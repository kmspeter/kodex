{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.invalid/schemas/release-acceptance-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "receiptFormatVersion", "releaseProfile", "trust", "commands", "requirements"],
  "properties": {
    "format": { "const": "kodex-release-acceptance-catalog" },
    "formatVersion": { "const": 1 },
    "receiptFormatVersion": { "const": 1 },
    "releaseProfile": { "const": "production" },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "minimumStoreVersion", "reference"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "minimumStoreVersion": { "type": "integer", "minimum": 1 },
        "reference": { "type": "string", "pattern": "^trustref:[a-z0-9][a-z0-9._-]{0,95}$" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executionClass", "id", "npmScript"],
        "properties": {
          "executionClass": { "enum": ["short", "targeted", "infrastructure", "full-stack", "build", "external", "long-run"] },
          "id": { "type": "string", "pattern": "^(acceptance|operations)\\.[a-z0-9-]+$" },
          "npmScript": { "type": ["string", "null"] }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "commandIds", "descriptionCode", "environments", "evidenceTypes", "id", "maximumAgeHours", "phases"],
        "properties": {
          "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "commandIds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string" } },
          "descriptionCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$" },
          "environments": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string" } },
          "evidenceTypes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
          "id": { "type": "string", "pattern": "^REL-[0-9]{3}$" },
          "maximumAgeHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
          "phases": { "type": "array", "minItems": 1, "maxItems": 36, "items": { "type": "integer", "minimum": 1, "maximum": 36 } }
        }
      }
    }
  }
}
