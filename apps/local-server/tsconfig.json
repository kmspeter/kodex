{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": [
    { "path": "../../packages/codex-protocol" },
    { "path": "../../packages/kodex-api" },
    { "path": "../../packages/shared" }
  ],
  "include": ["src/**/*.ts"]
}
