OPENAI_API_KEY=your_openai_api_key_here
# RAG is disabled by default. Enabling it sends registered document chunks,
# explicit Knowledge search-preview queries, and the first text query in a normal
# agent turn to the OpenAI Embeddings API. Automation prompts are included only
# when KODEX_RAG_AUTOMATIONS_ENABLED is also true. The repository/source tree,
# clipboard, and complete Codex history are not scanned or sent automatically.
# Changing the Codex generation provider to Local does not change this RAG
# provider; enable both of the following only after reviewing external transfer.
# KODEX_RAG_ENABLED=true
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# OPENAI_EMBEDDING_TIMEOUT_MS=15000
# OPENAI_EMBEDDING_BATCH_SIZE=32
# OPENAI_EMBEDDING_MAX_RETRIES=2
# OPENAI_EMBEDDING_MAX_RESPONSE_BYTES=16777216
# KODEX_RAG_CHUNK_CHARACTERS=1600
# KODEX_RAG_CHUNK_OVERLAP_CHARACTERS=200
# KODEX_RAG_TOP_K=5
# KODEX_RAG_MAX_TOP_K=20
# KODEX_RAG_SCORE_THRESHOLD=0.25
# KODEX_RAG_CONTEXT_MAX_CHARACTERS=6000
# KODEX_RAG_DOCUMENT_MAX_CHARACTERS=60000
# KODEX_RAG_QUERY_MAX_CHARACTERS=4000
# Automations do not use RAG unless this explicit opt-in is enabled.
# KODEX_RAG_AUTOMATIONS_ENABLED=false
# Optional: only when the selected loopback local provider requires a bearer token.
# KODEX_LOCAL_LLM_API_KEY=local-only-token

# Optional phase-1 product database. Copy this file to an ignored local env file and
# replace the password; never commit real credentials.
PRODUCT_DB_NAME=kodex
PRODUCT_DB_USER=kodex
PRODUCT_DB_PASSWORD=replace_with_a_local_only_password
PRODUCT_DB_PORT=5432
DATABASE_URL=postgresql://kodex:replace_with_a_local_only_password@127.0.0.1:5432/kodex
PRODUCT_DB_SSL=disable
# Optional private CA chain for verify-full. Literal \n separators are expanded.
# PRODUCT_DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PRODUCT_DB_POOL_MAX=10
# PRODUCT_DB_IDLE_TIMEOUT_MS=30000
# PRODUCT_DB_CONNECT_TIMEOUT_MS=5000
# Offline backup/restore uses pg_dump/pg_restore from PATH by default. Set exact
# executable paths only when PostgreSQL client tools are installed elsewhere.
# Docker/Compose drills may instead pass --database-container on the command line.
# KODEX_PG_DUMP_BIN=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# KODEX_PG_RESTORE_BIN=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe

# Release provenance is not a secret. Production image builds should inject the
# exact clean Git HEAD; sealed Windows releases set this from metadata/release.json.
# KODEX_RELEASE_COMMIT=0123456789abcdef0123456789abcdef01234567

# Optional server-only operational status endpoints. Generate separate random
# 32-byte base64url secrets and inject them from a secret manager. When unset,
# each /api/operations/status route is disabled (404). Never use a VITE_ prefix.
# PRODUCT_OPERATIONS_BEARER_TOKEN=replace_with_a_distinct_32_plus_character_secret
# KODEX_OPERATIONS_BEARER_TOKEN=replace_with_another_distinct_32_plus_character_secret

# Stage-3 browser-public product API origin. In development, keep this hostname
# identical to the UI hostname; do not mix localhost and 127.0.0.1. This is the
# only product-auth setting intended for the Vite bundle.
VITE_PRODUCT_API_URL=http://127.0.0.1:47832

# Product authentication API server settings. Never add DATABASE_URL,
# AUTH_COOKIE_SECRET, or an OpenAI/provider key under a VITE_ prefix.
# Generate the cookie secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_COOKIE_SECRET=replace_with_a_base64url_32_byte_secret
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:47831
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=43200
# PostgreSQL-backed login failure limit shared by all Product API processes.
# Raw email/direct socket address values are HMACed and are never stored.
# AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=5
# AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_LOGIN_RATE_LIMIT_BLOCK_SECONDS=900
# PostgreSQL-shared register and invitation abuse limits. Every subject is stored
# only as an action-and-kind-domain-separated HMAC. Attempts hard range 2..100,
# windows 60..86400 seconds, blocks 30..86400 seconds. Direct peer addresses are
# taken only from the Node socket; Forwarded/X-Forwarded-For are never trusted.
# AUTH_REGISTER_RATE_LIMIT_ATTEMPTS=5
# AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# AUTH_REGISTER_RATE_LIMIT_BLOCK_SECONDS=3600
# AUTH_INVITATION_PREVIEW_RATE_LIMIT_ATTEMPTS=10
# AUTH_INVITATION_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_INVITATION_PREVIEW_RATE_LIMIT_BLOCK_SECONDS=900
# AUTH_INVITATION_ACCEPT_RATE_LIMIT_ATTEMPTS=5
# AUTH_INVITATION_ACCEPT_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_INVITATION_ACCEPT_RATE_LIMIT_BLOCK_SECONDS=900
# Password recovery is opt-in because it requires an external delivery provider.
# The webhook receives one bearer-authenticated JSON request containing the target
# email and a fragment-only reset URL. It must never log or persist that URL/token.
# Production requires HTTPS for both URLs. Generate a distinct provider secret;
# do not reuse AUTH_COOKIE_SECRET.
# AUTH_PASSWORD_RESET_ENABLED=false
# AUTH_PASSWORD_RESET_DELIVERY_URL=https://mailer.example.com/v1/kodex-password-reset
# AUTH_PASSWORD_RESET_PUBLIC_ORIGIN=https://kodex.example.com
# AUTH_PASSWORD_RESET_DELIVERY_BEARER_TOKEN=replace_with_a_distinct_32_plus_character_secret
# AUTH_PASSWORD_RESET_DELIVERY_TIMEOUT_MS=5000
# AUTH_PASSWORD_RESET_TTL_MINUTES=60
# AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT_ATTEMPTS=5
# AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
# AUTH_PASSWORD_RESET_REQUEST_RATE_LIMIT_BLOCK_SECONDS=3600
# AUTH_PASSWORD_RESET_COMPLETE_RATE_LIMIT_ATTEMPTS=5
# AUTH_PASSWORD_RESET_COMPLETE_RATE_LIMIT_WINDOW_SECONDS=900
# AUTH_PASSWORD_RESET_COMPLETE_RATE_LIMIT_BLOCK_SECONDS=900
# Bounded Product API maintenance for terminal session/invitation rows and stale
# HMAC-only login/product-abuse buckets. Hard ranges: interval 60..86400 seconds, batch 1..1000,
# max batches 1..100, and each row-retention window 1..3650 days.
# PRODUCT_RETENTION_ENABLED=true
# PRODUCT_RETENTION_INTERVAL_SECONDS=3600
# PRODUCT_RETENTION_BATCH_SIZE=100
# PRODUCT_RETENTION_MAX_BATCHES=10
# PRODUCT_RETENTION_SESSION_DAYS=30
# PRODUCT_RETENTION_INVITATION_DAYS=30
# PRODUCT_RETENTION_PASSWORD_RESET_DAYS=30
# Copy-link workspace invitations: default seven days and 100 active pending rows.
# Hard ranges are 1..720 hours and 1..500 pending invitations per workspace.
# WORKSPACE_INVITATION_TTL_HOURS=168
# WORKSPACE_INVITATION_PENDING_LIMIT=100
PRODUCT_API_HOST=127.0.0.1
PRODUCT_API_PORT=47832
PRODUCT_API_ALLOWED_HOSTS=127.0.0.1:47832
# Default 262144 accommodates a 60000-code-point document plus JSON overhead.
# Increase it when increasing KODEX_RAG_DOCUMENT_MAX_CHARACTERS; startup rejects
# an unsafe combination. The hard maximum is 1048576 bytes.
# PRODUCT_API_MAX_BODY_BYTES=262144
# PRODUCT_API_NODE_ENV=development

# Tenant runtime limits. KODEX_DATA_ROOT must be a dedicated writable directory,
# not a drive root, home, or repository/source root. KODEX_TENANT_ROOT must stay
# strictly inside that trusted base. Source defaults to .kodex-data; desktop owns
# its separate userData location and overrides both values.
# KODEX_DATA_ROOT=D:\dedicated\kodex-data
# KODEX_TENANT_ROOT=D:\dedicated\kodex-data\tenants
# KODEX_MAX_ACTIVE_RUNTIMES=8
# KODEX_RUNTIME_IDLE_MS=900000
# KODEX_RUNTIME_SWEEP_MS=60000
# Product session/membership revalidation interval for established Local WebSockets.
# Keep the 300000 ms production default unless a controlled test needs a shorter bound.
# KODEX_AUTH_REVALIDATE_MS=300000
# Per-tenant product history outbox. Files stay under the authenticated tenant
# data root, contain only bounded/redacted projection commands, and are replayed
# in order after a PostgreSQL outage or Local Server restart.
# KODEX_HISTORY_EVENT_MAX_BYTES=65536
# KODEX_HISTORY_OUTBOX_MAX_BYTES=16777216
# KODEX_HISTORY_OUTBOX_MAX_RECORDS=10000
# KODEX_HISTORY_RETRY_INITIAL_MS=250
# KODEX_HISTORY_RETRY_MAX_MS=30000
# Read-only tenant App Server reconciliation. Active and archived threads are
# paged with every pinned public source kind; turns/items use their paginated
# public methods. Runs in the background and always writes through the outbox.
# Invalid values or an initial retry greater than the maximum fail startup.
# KODEX_HISTORY_RECONCILIATION_INTERVAL_MS=900000
# KODEX_HISTORY_RECONCILIATION_RETRY_INITIAL_MS=5000
# KODEX_HISTORY_RECONCILIATION_RETRY_MAX_MS=300000
# KODEX_HISTORY_RECONCILIATION_REQUEST_TIMEOUT_MS=15000
# KODEX_HISTORY_RECONCILIATION_PAGE_SIZE=50
# KODEX_HISTORY_RECONCILIATION_MAX_THREADS_PER_STATE=500
# KODEX_HISTORY_RECONCILIATION_MAX_TURNS_PER_THREAD=1000
# KODEX_HISTORY_RECONCILIATION_MAX_ITEMS_PER_THREAD=5000
# Browser-safe exact Product API origins used only for built UI CSP connect-src.
# Defaults are derived from PRODUCT_API_PORT by npm run dev/start.
# KODEX_PRODUCT_API_ORIGINS=http://127.0.0.1:47832,http://localhost:47832
