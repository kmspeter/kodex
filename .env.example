OPENAI_API_KEY=your_openai_api_key_here
# Optional: only when the selected loopback local provider requires a bearer token.
# KODEX_LOCAL_LLM_API_KEY=local-only-token

# Optional phase-1 product database. Copy this file to an ignored local env file and
# replace the password; never commit real credentials.
PRODUCT_DB_NAME=kodex
PRODUCT_DB_USER=kodex
PRODUCT_DB_PASSWORD=replace_with_a_local_only_password
PRODUCT_DB_PORT=5432
DATABASE_URL=postgresql://kodex:replace_with_a_local_only_password@127.0.0.1:5432/kodex
PRODUCT_DB_SSL=disable
# PRODUCT_DB_POOL_MAX=10
# PRODUCT_DB_IDLE_TIMEOUT_MS=30000
# PRODUCT_DB_CONNECT_TIMEOUT_MS=5000
