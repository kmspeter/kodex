{
  "name": "kodex",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-kodex.mjs dev",
    "build": "npm run build --workspace @kodex/codex-protocol && npm run build --workspace @kodex/kodex-api && npm run build --workspace @kodex/shared && npm run build --workspace @kodex/local-server && npm run build --workspace @kodex/ui",
    "start": "node scripts/run-kodex.mjs start",
    "test": "npm run typecheck && vitest run",
    "test:integration": "vitest run test/integration",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "eslint apps packages scripts test --max-warnings=0",
    "typecheck": "tsc -b --pretty && tsc -p test/tsconfig.json --noEmit --pretty",
    "codex:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-codex.ps1",
    "codex:generate-protocol": "node scripts/generate-protocol.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
